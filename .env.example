# Conexión con Supabase. Copia este archivo como .env.local y completa los valores
# (Supabase → Project Settings → API Keys). Si los dejas vacíos, la app usa los datos simulados.
# Ambos valores son públicos: viajan dentro de la app. NUNCA pongas aquí la clave secreta
# (service_role / secret key).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
