{
  "expo": {
    "name": "Convive",
    "slug": "convive",
    "version": "0.4.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.darksteven30.convive"
    },
    "android": {
      "package": "com.darksteven30.convive",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Convive necesita acceso a tus fotos para adjuntar soportes e imágenes.",
          "cameraPermission": "Convive necesita acceso a la cámara para fotografiar soportes e imágenes.",
          "microphonePermission": false
        }
      ],
      "expo-sharing",
      "expo-sqlite",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#0F766E",
          "defaultChannel": "default"
        }
      ]
    ],
    "scheme": "convive",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4d2d1d68-e3bd-410a-8160-cbbf6d10433b"
      }
    },
    "owner": "darkstevens-team"
  }
}
